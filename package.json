{
  "name": "shards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/engine.test.ts tests/constellation.test.ts",
    "test:browser": "node --experimental-strip-types --test tests/browser.test.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "start": "node server.mjs",
    "deploy:azure": "pwsh -NoProfile -File infra\\deploy.ps1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
