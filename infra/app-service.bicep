param location string
param appName string

// One dedicated Linux B1 worker: no autoscaling or additional paid services.
resource plan 'Microsoft.Web/serverfarms@2026-08-01' = {
  name: 'plan-the-confluence'
  location: location
  kind: 'linux'
  tags: {
    application: 'The Confluence'
    managedBy: 'Bicep'
  }
  sku: {
    name: 'B1'
    tier: 'Basic'
    capacity: 1
  }
  properties: {
    reserved: true
    perSiteScaling: false
    zoneRedundant: false
  }
}

resource site 'Microsoft.Web/sites@2026-08-01' = {
  name: appName
  location: location
  kind: 'app,linux'
  tags: {
    application: 'The Confluence'
    managedBy: 'Bicep'
  }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    publicNetworkAccess: 'Enabled'
    clientAffinityEnabled: false
    // Azure generates a hashed hostname rather than a reusable unprotected DNS label.
    autoGeneratedDomainNameLabelScope: 'ResourceGroupReuse'
    siteConfig: {
      linuxFxVersion: 'NODE|24-lts'
      appCommandLine: 'node server.mjs'
      alwaysOn: true
      minTlsVersion: '1.2'
      scmMinTlsVersion: '1.2'
      ftpsState: 'Disabled'
      http20Enabled: true
      appSettings: [
        {
          name: 'NODE_ENV'
          value: 'production'
        }
        {
          name: 'SCM_DO_BUILD_DURING_DEPLOYMENT'
          value: 'false'
        }
        {
          name: 'ENABLE_ORYX_BUILD'
          value: 'false'
        }
        {
          name: 'WEBSITE_RUN_FROM_PACKAGE'
          value: '1'
        }
      ]
    }
  }
}

// Deployment uses the signed-in Azure CLI's Entra token, not publishing passwords.
resource scmPolicy 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2026-08-01' = {
  parent: site
  name: 'scm'
  properties: {
    allow: false
  }
}

resource ftpPolicy 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2026-08-01' = {
  parent: site
  name: 'ftp'
  properties: {
    allow: false
  }
}

output appUrl string = 'https://${site.properties.defaultHostName}'
